{
  "name": "room-master-backend",
  "version": "1.0.0",
  "scripts": {
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "rimraf build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "docker compose -f docker-compose.only-db-test.yml up -d && dotenv -e .env.test -- yarn db:reset && dotenv -e .env.test -- yarn db:seed && jest -i --colors --verbose --detectOpenHandles && docker compose -f docker-compose.only-db-test.yml down",
    "test:watch": "docker compose -f docker-compose.only-db-test.yml up -d && dotenv -e .env.test -- yarn db:reset && dotenv -e .env.test -- yarn db:seed && jest -i --watchAll && docker compose -f docker-compose.only-db-test.yml down",
    "test:coverage": "docker compose -f docker-compose.only-db-test.yml up -d && dotenv -e .env.test -- yarn db:reset && dotenv -e .env.test -- yarn db:seed && jest -i --coverage --colors --verbose && docker compose -f docker-compose.only-db-test.yml down",
    "test:integration": "docker compose -f docker-compose.only-db-test.yml up -d && dotenv -e .env.test -- yarn db:reset && dotenv -e .env.test -- yarn db:seed && jest -i --testPathPattern=integration --colors --verbose --detectOpenHandles && docker compose -f docker-compose.only-db-test.yml down",
    "test:unit": "jest -i --testPathPattern=unit --colors --verbose",
    "test:booking-flow": "docker compose -f docker-compose.only-db-test.yml up -d && dotenv -e .env.test -- yarn db:reset && dotenv -e .env.test -- yarn db:seed && jest -i tests/integration/booking-flow.test.ts --colors --verbose && docker compose -f docker-compose.only-db-test.yml down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.ts",
    "prettier:fix": "prettier --write **/*.ts",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seeds/index.ts",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:test": "docker compose -f docker-compose.yml -f docker-compose.test.yml up",
    "docker:dev-db:start": "docker compose -f docker-compose.only-db-dev.yml up -d",
    "docker:dev-db:stop": "docker compose -f docker-compose.only-db-dev.yml down",
    "prepare": "husky install",
    "swagger:generate": "node scripts/generate-swagger.js"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "keywords": [
    "node",
    "node.js",
    "typescript",
    "boilerplate",
    "express",
    "rest",
    "api",
    "prisma",
    "postgresql",
    "es6",
    "es7",
    "es8",
    "es9",
    "docker",
    "passport",
    "joi",
    "eslint",
    "prettier"
  ],
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@jest/globals": "^30.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.8",
    "@types/node-cache": "^4.2.5",
    "@types/nodemailer": "^7.0.5",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xss-filters": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "prisma": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.8",
    "@ai-sdk/openai": "^3.0.10",
    "@casl/ability": "^6.7.5",
    "@casl/prisma": "^1.6.0",
    "@prisma/client": "7.2.0",
    "@types/bcryptjs": "^3.0.0",
    "ai": "^6.0.35",
    "awilix": "^12.0.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "joi": "^18.0.2",
    "lexorank": "^1.0.5",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^6.0.14",
    "rrule": "^2.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xss-filters": "^1.2.7",
    "zod": "4.3.5"
  },
  "resolutions": {
    "@types/express": "4.17.25"
  },
  "prisma": {
    "seed": "ts-node prisma/seeds/index.ts"
  }
}
